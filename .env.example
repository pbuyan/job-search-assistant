# Copy to .env.local and fill in. Never commit real values.

# Postgres + pgvector. On Vercel, use the pooled (pgbouncer / transaction-mode) URL.
DATABASE_URL=

# Claude API (read by @ai-sdk/anthropic)
ANTHROPIC_API_KEY=
# Optional: required only for user-scoped API keys
ANTHROPIC_WORKSPACE_ID=

# Voyage AI embeddings
VOYAGE_API_KEY=
# Optional: e.g. https://ai.mongodb.com/v1 for MongoDB Atlas model API keys
VOYAGE_BASE_URL=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# E2E (Playwright). A dedicated Clerk dev-instance user; the signed-in specs
# overwrite its profile. Leave empty to run only the signed-out specs.
E2E_CLERK_USER_EMAIL=
# Set to 1 to also run the paste → analyze → track flow (real Claude/Voyage calls)
E2E_AI=
