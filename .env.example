# Copy to .env.local and fill in. Never commit real values.

# Postgres + pgvector. On Vercel, use the pooled (pgbouncer / transaction-mode) URL.
DATABASE_URL=

# Claude API (read by @ai-sdk/anthropic)
ANTHROPIC_API_KEY=
# Optional: required only for user-scoped API keys
ANTHROPIC_WORKSPACE_ID=

# Voyage AI embeddings
VOYAGE_API_KEY=
# Optional: e.g. https://ai.mongodb.com/v1 for MongoDB Atlas model API keys
VOYAGE_BASE_URL=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook endpoint /api/webhooks/clerk (event:
# user.deleted), from the Clerk dashboard → Webhooks
CLERK_WEBHOOK_SIGNING_SECRET=

# Vercel Blob read-write token of a PRIVATE store (Vercel → Storage → Blob →
# create with private access). Keeps imported resume files and the PDF of each
# sent resume. Optional locally: without it nothing is stored.
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/refresh-jobs, the daily check that marks imported
# Greenhouse/Lever/Ashby postings closed (vercel.json). Vercel Cron sends it as
# a bearer token; set any long random string. Without it the route refuses
# every call.
CRON_SECRET=

# Optional: scales every per-user daily AI cap (src/lib/ai/quotas.ts), e.g. 10
# for dev/e2e. Unset means the default caps.
AI_DAILY_LIMIT_MULTIPLIER=

# E2E (Playwright). A dedicated Clerk dev-instance user; the signed-in specs
# overwrite its profile. Leave empty to run only the signed-out specs.
E2E_CLERK_USER_EMAIL=
# Set to 1 to also run the paste → analyze → track flow (real Claude/Voyage calls)
E2E_AI=
